<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IdermaClinica.Pages.HistorialPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:IdermaClinica.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:IdermaClinica.Models"
    mc:Ignorable="d">

    <Grid Padding="20,8,20,10" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Historial de pedidos" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Las solicitudes van a logística. Aquí verás si las aceptan o deniegan." />
        </StackPanel>

        <InfoBar
            x:Name="AvisoHistorial"
            Grid.Row="1"
            IsOpen="False" />

        <Grid Grid.Row="2">
            <ListView
                x:Name="ListaHistorial"
                IsItemClickEnabled="False"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource QuietListViewItemStyle}" />
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:PedidoHistorial">
                        <Border
                            Padding="12,8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource OverlayCornerRadius}">
                            <Grid RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="0">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Folio}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind FechaTexto}" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <Border
                                            Padding="8,2"
                                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                            CornerRadius="{ThemeResource ControlCornerRadius}"
                                            Visibility="{x:Bind Urgente, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Urgente" />
                                        </Border>
                                        <Border
                                            Padding="8,2"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="{ThemeResource ControlCornerRadius}"
                                            Visibility="{x:Bind EstaEnviado, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Enviado" />
                                        </Border>
                                        <Border
                                            Padding="8,2"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="{ThemeResource ControlCornerRadius}"
                                            Visibility="{x:Bind EstaAtendido, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock
                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="Atendido" />
                                        </Border>
                                        <Border
                                            Padding="8,2"
                                            Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                            CornerRadius="{ThemeResource ControlCornerRadius}"
                                            Visibility="{x:Bind EstaAceptado, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Aceptado" />
                                        </Border>
                                        <Border
                                            Padding="8,2"
                                            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                            CornerRadius="{ThemeResource ControlCornerRadius}"
                                            Visibility="{x:Bind EstaDenegado, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Denegado" />
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <TextBlock
                                    Grid.Row="1"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Detalle, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Grid.Row="2"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind DetalleRespuesta, Mode=OneWay}"
                                    TextWrapping="Wrap" />

                                <StackPanel
                                    Grid.Row="3"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <Button Click="Repetir_Click" Content="Repetir" />
                                    <Button Click="Anclar_Click" Content="Anclar a la lista" />
                                    <Button
                                        Click="Atender_Click"
                                        Content="Atendido"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Visibility="{x:Bind EstaEnviado, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock
                x:Name="EstadoVacio"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Aún no hay pedidos procesados."
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</Page>
